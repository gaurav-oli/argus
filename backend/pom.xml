<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.argus</groupId>
	<artifactId>argus-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>argus</name>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
		<spring-ai.version>2.0.1</spring-ai.version>
		<resilience4j.version>2.4.0</resilience4j.version>
		<ta4j.version>0.25.0</ta4j.version>
		<commons-math3.version>3.6.1</commons-math3.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- Spring AI is NOT managed by the Spring Boot BOM — import its own BOM. -->
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<!-- Resilience4j core (rate limiter + retry), applied programmatically. The Spring Boot
		     starter targets Boot 3, so we use the framework-agnostic core modules on Boot 4. -->
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-ratelimiter</artifactId>
			<version>${resilience4j.version}</version>
		</dependency>
		<dependency>
			<groupId>io.github.resilience4j</groupId>
			<artifactId>resilience4j-retry</artifactId>
			<version>${resilience4j.version}</version>
		</dependency>
		<dependency>
			<!-- Agent 10 — MACD/Bollinger %B (Technical Analysis), on top of the hand-rolled
			     RSI/SMA/drawdown in TechnicalIndicators. Real open-source library, not hand-coded
			     indicator math for every new one. -->
			<groupId>org.ta4j</groupId>
			<artifactId>ta4j-core</artifactId>
			<version>${ta4j.version}</version>
		</dependency>
		<dependency>
			<!-- Portfolio correlation risk (HealthScoreService) — PearsonsCorrelation. Already
			     resolved transitively via ta4j (same version), declared explicitly rather than
			     relying on an implicit transitive of an unrelated library. -->
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-math3</artifactId>
			<version>${commons-math3.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket</artifactId>
		</dependency>

		<dependency>
			<!-- Spring AI 2.0 Ollama ChatModel + ChatClient core (prod big-model path, local). -->
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-ollama</artifactId>
		</dependency>

		<dependency>
			<!-- Spring AI 2.0 Anthropic — Claude Haiku escalation/fallback (Story 7.3, FR-32).
			     Key-gated: the Anthropic ChatModel is built manually only when an API key is set,
			     so its chat autoconfig is disabled (spring.ai.model.chat=ollama) to avoid a second
			     competing ChatModel bean. -->
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-anthropic</artifactId>
		</dependency>

		<dependency>
			<!-- Official Anthropic Java SDK okhttp transport — provides AnthropicOkHttpClient so the
			     Haiku client can be built manually in HaikuConfig (the starter pulls only -core).
			     Pinned to the -core version Spring AI 2.0 resolves transitively. -->
			<groupId>com.anthropic</groupId>
			<artifactId>anthropic-java-client-okhttp</artifactId>
			<version>2.40.1</version>
		</dependency>

		<dependency>
			<!-- Apache PDFBox 3.0.x — deterministic text extraction from brokerage
			     statement PDFs (Story 3.1, FR-1). 3.x API: load via Loader.loadPDF(...)
			     (the 2.x static PDDocument.load was removed); extract with PDFTextStripper. -->
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.8</version>
		</dependency>

		<dependency>
			<!-- Password encoders ONLY (Argon2PasswordEncoder for the PIN hash, Story 2.1).
			     Deliberately NOT spring-boot-starter-security — Decision 5 keeps the full
			     Spring Security filter chain deferred; we implement custom session auth. -->
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<!-- Argon2PasswordEncoder requires BouncyCastle on the classpath. -->
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>1.86</version>
		</dependency>
		<dependency>
			<!-- WebAuthn/passkey ceremonies (Story 2.2). Standalone — no Spring Security
			     (Decision 5). Brings its own Jackson 2 for the ceremony JSON helpers. -->
			<groupId>com.yubico</groupId>
			<artifactId>webauthn-server-core</artifactId>
			<version>2.9.0</version>
		</dependency>

		<dependency>
			<!-- Web Push / VAPID (Epic 8, FR-17): RFC 8291 payload encryption + RFC 8292 VAPID auth.
			     Ships a legacy BouncyCastle (jdk15on) that would duplicate the bcprov-jdk18on:1.81
			     already on the classpath (Argon2) — excluded; we add the matching bcpkix-jdk18on so
			     the single BC 1.81 satisfies it. Verify dependency resolution on the Mini (see
			     docs/mac-mini-validation.md). -->
			<groupId>nl.martijndwars</groupId>
			<artifactId>web-push</artifactId>
			<version>5.1.2</version>
			<exclusions>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcprov-jdk15on</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcpkix-jdk15on</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<!-- PKIX helpers the web-push library needs, matched to bcprov-jdk18on:1.86. -->
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcpkix-jdk18on</artifactId>
			<version>1.86</version>
		</dependency>
		<dependency>
			<!-- web-push 5.1.2 resolves this transitively as runtime-only, but WebPushSender reads
			     the org.apache.http.HttpResponse PushService.send() returns, which needs it at
			     compile time too. Pinned to the version web-push's own tree already resolves. -->
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>4.5.13</version>
		</dependency>
		<dependency>
			<!-- Same runtime-vs-compile issue as httpclient above: PushService.send() declares a
			     checked org.jose4j.lang.JoseException, which needs jose4j on the compile classpath. -->
			<groupId>org.bitbucket.b_c</groupId>
			<artifactId>jose4j</artifactId>
			<version>0.7.9</version>
		</dependency>

		<dependency>
			<!-- Boot 4 Flyway autoconfiguration module (pulls flyway-core transitively).
			     flyway-core alone does NOT enable autoconfig in Boot 4. -->
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-websocket-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
